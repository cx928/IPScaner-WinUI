<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="IPScaner.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="局域网IP扫描工具">

    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Custom title bar -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="40" Padding="12,0,12,0"
              Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE968;" FontSize="16" />
                <TextBlock Text="局域网IP扫描工具" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock x:Name="VersionText" Text="WinUI 1.28.2" VerticalAlignment="Center"
                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Border x:Name="ElevationBadge" CornerRadius="10" Padding="8,2,8,2"
                        Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                        Visibility="Collapsed" ToolTipService.ToolTip="部分功能（修改本地IP、清空ARP缓存）需要管理员权限">
                    <TextBlock x:Name="ElevationText" FontSize="11" Text="未提权" />
                </Border>
                <Button x:Name="ElevateButton" Content="以管理员身份重启" FontSize="12"
                        Visibility="Collapsed" Click="OnRestartElevated" />
            </StackPanel>
        </Grid>

        <!-- Shell -->
        <muxc:NavigationView
            x:Name="Nav"
            Grid.Row="1"
            IsSettingsVisible="False"
            IsBackButtonVisible="Collapsed"
            PaneDisplayMode="Left"
            OpenPaneLength="228"
            IsPaneToggleButtonVisible="True"
            SelectionChanged="OnNavSelectionChanged">

            <muxc:NavigationView.MenuItems>
                <muxc:NavigationViewItem Content="IP段扫描" Tag="scan" ToolTipService.ToolTip="Ping 扫描整个 /24 网段">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE774;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="IP批量扫描" Tag="batch" ToolTipService.ToolTip="按网段、IP范围或掩码位批量扫描">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8A9;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="端口扫描" Tag="portscan" ToolTipService.ToolTip="扫描目标主机开放的端口">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE968;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="本机端口占用" Tag="localport" ToolTipService.ToolTip="查看本机 TCP/UDP 端口占用情况">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D9;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Hosts 管理" Tag="hosts" ToolTipService.ToolTip="一键管理 hosts 记录：添加、删除、改 IP、清理失效记录、刷新 DNS 缓存">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE968;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="网络工具" Tag="tools" ToolTipService.ToolTip="DNS 一键切换、SSH/RDP 快捷连接与常用诊断命令">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE774;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItemSeparator />
                <muxc:NavigationViewItem Content="修改本地IP" Tag="localip" ToolTipService.ToolTip="修改网卡 IP、掩码、网关与 DNS">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE72C;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="WiFi密码查看" Tag="wifi" ToolTipService.ToolTip="查看已保存的 WiFi 名称与密码">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE701;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="IP地址计算器" Tag="calc" ToolTipService.ToolTip="根据 IP 和掩码位计算网络地址">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8EF;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="备注管理" Tag="memo" ToolTipService.ToolTip="维护 IP / MAC 的备注信息">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE70B;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
            </muxc:NavigationView.MenuItems>

            <muxc:NavigationView.FooterMenuItems>
                <muxc:NavigationViewItem Content="选项配置" Tag="config">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="关于" Tag="about">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
            </muxc:NavigationView.FooterMenuItems>

            <Frame x:Name="ContentFrame" />
        </muxc:NavigationView>

        <!-- Status bar: mirrors the original StatusStrip -->
        <Border Grid.Row="2" Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                Padding="12,6,12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusText" Grid.Column="0" Style="{StaticResource StatusTextStyle}"
                           MinWidth="220" Text="就绪" />

                <TextBlock x:Name="TipText" Grid.Column="1" Style="{StaticResource HintTextStyle}"
                           VerticalAlignment="Center" Margin="16,0,16,0"
                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />

                <TextBlock x:Name="ClockText" Grid.Column="2" Style="{StaticResource StatusTextStyle}"
                           Text="--:--:--" />
            </Grid>
        </Border>
    </Grid>
</Window>
