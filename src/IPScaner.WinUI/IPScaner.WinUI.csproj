<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>IPScaner.WinUI</RootNamespace>
    <AssemblyName>IPScaner</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>

    <!-- Stamped into the exe and shown on the 关于 page. -->
    <Version>1.28.2</Version>
    <AssemblyVersion>1.28.2.0</AssemblyVersion>
    <FileVersion>1.28.2.0</FileVersion>
    <Product>局域网IP扫描工具</Product>
    <AssemblyTitle>IPScaner</AssemblyTitle>
    <Company>IPScaner</Company>
    <Description>局域网IP扫描工具 —— WinUI 3 重构版</Description>
    <Copyright>原始版本 Copyright © chenhuxiang@qq.com 2019-2025</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.7175" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\IPScaner.Core\IPScaner.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      ApplicationIcon only embeds the icon as a Win32 resource. Both the window
      icon (AppWindow.SetIcon) and the tray icon (LoadImage) load it from disk at
      runtime, so it must also be copied next to the executable — otherwise both
      silently fall back to the generic application icon.
    -->
    <Content Include="Assets\app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
