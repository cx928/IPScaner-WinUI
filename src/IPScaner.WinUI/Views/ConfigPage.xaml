<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="IPScaner.WinUI.Views.ConfigPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <!-- The original painted a bare 31x32 Panel; a thin border keeps the
             swatch visible when the chosen colour matches the page background. -->
        <Style x:Key="ColorSwatchStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
        </Style>
        <Style x:Key="RowLabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>
        <!-- 31x32 in the original; widened so the colour is easy to click. -->
        <Style x:Key="SwatchButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="84" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style x:Key="TabGridStyle" TargetType="Grid">
            <Setter Property="Padding" Value="4,10,4,10" />
            <Setter Property="ColumnSpacing" Value="12" />
            <Setter Property="RowSpacing" Value="8" />
        </Style>
    </Page.Resources>

    <Grid Padding="16,10,16,10" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================= header + 保存 / 关闭 ================= -->
        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource HintTextStyle}"
                           Text="编辑的是配置副本：【保存】写入 IPScaner.cfg 并生效，【关闭】放弃修改。" />
                <TextBlock x:Name="ClampNoticeText" Style="{StaticResource HintTextStyle}"
                           Foreground="{ThemeResource SystemFillColorCautionBrush}"
                           Visibility="Collapsed" />
            </StackPanel>

            <!-- btnSave / btnClose of the original, moved into the page toolbar -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Button Content="保存" Click="OnSaveClick" Style="{StaticResource AccentButtonStyle}" MinWidth="110" />
                <Button Content="关闭" Click="OnCloseClick" MinWidth="110" />
            </StackPanel>
        </Grid>

        <!-- ================= 三个选项卡 ================= -->
        <TabView Grid.Row="1" IsAddTabButtonVisible="False"
                 CanDragTabs="False" CanReorderTabs="False" TabWidthMode="SizeToContent">
            <TabView.TabItems>

                <!-- ========== 外观 (tabPage1) ========== -->
                <TabViewItem Header="外观" IsClosable="False">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid Style="{StaticResource TabGridStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="150" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="小色块字号" Style="{StaticResource RowLabelStyle}" />
                            <ComboBox x:Name="FontSizeCombo" Grid.Row="0" Grid.Column="1" Width="180" IsEditable="False" />

                            <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="注：变更小色块字号需要重启"
                                       Style="{StaticResource HintTextStyle}"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="初始色块颜色" Style="{StaticResource RowLabelStyle}" />
                            <Button Grid.Row="2" Grid.Column="1" Style="{StaticResource SwatchButtonStyle}"
                                    Click="OnPickDefaultColor"
                                    AutomationProperties.Name="初始色块颜色，点击选择颜色" ToolTipService.ToolTip="点击选择颜色">
                                <Border x:Name="DefaultColorSwatch" Style="{StaticResource ColorSwatchStyle}" />
                            </Button>
                            <TextBlock x:Name="DefaultColorArgbText" Grid.Row="2" Grid.Column="2"
                                       Style="{StaticResource HintTextStyle}" VerticalAlignment="Center" />

                            <!-- 原版把这两个标签写死成 LimeGreen / IndianRed 作为装饰 -->
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="通讯正常颜色" Style="{StaticResource RowLabelStyle}" Foreground="#32CD32" />
                            <Button Grid.Row="3" Grid.Column="1" Style="{StaticResource SwatchButtonStyle}"
                                    Click="OnPickOkColor"
                                    AutomationProperties.Name="通讯正常颜色，点击选择颜色" ToolTipService.ToolTip="点击选择颜色">
                                <Border x:Name="OkColorSwatch" Style="{StaticResource ColorSwatchStyle}" />
                            </Button>
                            <TextBlock x:Name="OkColorArgbText" Grid.Row="3" Grid.Column="2"
                                       Style="{StaticResource HintTextStyle}" VerticalAlignment="Center" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="通讯异常颜色" Style="{StaticResource RowLabelStyle}" Foreground="#CD5C5C" />
                            <Button Grid.Row="4" Grid.Column="1" Style="{StaticResource SwatchButtonStyle}"
                                    Click="OnPickNgColor"
                                    AutomationProperties.Name="通讯异常颜色，点击选择颜色" ToolTipService.ToolTip="点击选择颜色">
                                <Border x:Name="NgColorSwatch" Style="{StaticResource ColorSwatchStyle}" />
                            </Button>
                            <TextBlock x:Name="NgColorArgbText" Grid.Row="4" Grid.Column="2"
                                       Style="{StaticResource HintTextStyle}" VerticalAlignment="Center" />

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="备注色块颜色" Style="{StaticResource RowLabelStyle}" />
                            <Button Grid.Row="5" Grid.Column="1" Style="{StaticResource SwatchButtonStyle}"
                                    Click="OnPickMemoColor"
                                    AutomationProperties.Name="备注色块颜色，点击选择颜色" ToolTipService.ToolTip="点击选择颜色">
                                <Border x:Name="MemoColorSwatch" Style="{StaticResource ColorSwatchStyle}" />
                            </Button>
                            <TextBlock x:Name="MemoColorArgbText" Grid.Row="5" Grid.Column="2"
                                       Style="{StaticResource HintTextStyle}" VerticalAlignment="Center" />

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="小色块双击事件" Style="{StaticResource RowLabelStyle}" />
                            <ComboBox x:Name="DoubleEventCombo" Grid.Row="6" Grid.Column="1" Width="180" IsEditable="False"
                                      ToolTipService.ToolTip="用右键菜单中的某一项代替双击事件" />

                            <TextBlock Grid.Row="7" Grid.Column="0" Text="自动弹出菜单" Style="{StaticResource RowLabelStyle}" />
                            <ToggleSwitch x:Name="MenuAutoOpenToggle" Grid.Row="7" Grid.Column="1"
                                          OnContent="是" OffContent="否"
                                          ToolTipService.ToolTip="鼠标划过菜单时，是否自动弹出菜单" />
                        </Grid>
                    </ScrollViewer>
                </TabViewItem>

                <!-- ========== 参数 (tabPage2) ========== -->
                <TabViewItem Header="参数" IsClosable="False">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid Style="{StaticResource TabGridStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="150" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="启用主机名查询" Style="{StaticResource RowLabelStyle}" />
                            <ToggleSwitch x:Name="QueryHostNameToggle" Grid.Row="0" Grid.Column="1"
                                          OnContent="启用" OffContent="禁用" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Ping超时毫秒" Style="{StaticResource RowLabelStyle}" />
                            <NumberBox x:Name="PingTimeoutBox" Grid.Row="1" Grid.Column="1" Width="180"
                                       Minimum="10" Maximum="5000" SmallChange="100" LargeChange="500"
                                       SpinButtonPlacementMode="Inline"
                                       ToolTipService.ToolTip="Ping时长超过此值，会认为网络异常" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="10 - 5000，步进 100" Style="{StaticResource HintTextStyle}" VerticalAlignment="Center" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Ping请求次数" Style="{StaticResource RowLabelStyle}" />
                            <NumberBox x:Name="PingCountBox" Grid.Row="2" Grid.Column="1" Width="180"
                                       Minimum="1" Maximum="100" SmallChange="1"
                                       SpinButtonPlacementMode="Inline"
                                       ToolTipService.ToolTip="一次Ping发送的包数量" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="1 - 100" Style="{StaticResource HintTextStyle}" VerticalAlignment="Center" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="双击间隔毫秒" Style="{StaticResource RowLabelStyle}" />
                            <NumberBox x:Name="DoubleClickBox" Grid.Row="3" Grid.Column="1" Width="180"
                                       Minimum="100" Maximum="500" SmallChange="50" LargeChange="50"
                                       SpinButtonPlacementMode="Inline" />
                            <TextBlock Grid.Row="3" Grid.Column="2" Text="100 - 500，步进 50" Style="{StaticResource HintTextStyle}" VerticalAlignment="Center" />

                            <CheckBox x:Name="ArpCheck" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
                                      Content="启用Ping失败时检测ARP表"
                                      ToolTipService.ToolTip="Ping失败时检查ARP路由表，判断设备是否在线" />

                            <CheckBox x:Name="PortCheck" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3"
                                      Content="启用Ping失败时侦测端口"
                                      ToolTipService.ToolTip="Ping失败时侦测TCP端口，判断设备是否在线"
                                      Checked="OnPortCheckChanged" Unchecked="OnPortCheckChanged" />

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="TCP侦测端口" Style="{StaticResource RowLabelStyle}"
                                       ToolTipService.ToolTip="Ping失败时，可通过此端口判断设备状态。多个端口之间用逗号分隔" />
                            <TextBox x:Name="PortBox" Grid.Row="6" Grid.Column="1" Width="180"
                                     ToolTipService.ToolTip="Ping失败时，可通过此端口判断设备状态"
                                     LostFocus="OnPortsLostFocus" />
                            <TextBlock Grid.Row="6" Grid.Column="2" Text="多个端口之间用逗号分隔，例如 80,135,445,500"
                                       Style="{StaticResource HintTextStyle}" VerticalAlignment="Center" />

                            <TextBlock Grid.Row="7" Grid.Column="0" Text="TCP超时毫秒" Style="{StaticResource RowLabelStyle}"
                                       ToolTipService.ToolTip="Ping时长超过此值，会认为网络异常" />
                            <NumberBox x:Name="PortTimeoutBox" Grid.Row="7" Grid.Column="1" Width="180"
                                       Minimum="10" Maximum="2000" SmallChange="50" LargeChange="100"
                                       SpinButtonPlacementMode="Inline"
                                       ToolTipService.ToolTip="Ping时长超过此值，会认为网络异常" />
                            <TextBlock Grid.Row="7" Grid.Column="2" Text="10 - 2000，步进 50" Style="{StaticResource HintTextStyle}" VerticalAlignment="Center" />

                            <CheckBox x:Name="LogCheck" Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="3"
                                      Content="启用调试日志" Foreground="#1E90FF"
                                      ToolTipService.ToolTip="当前程序目录下生成Logs目录" />

                            <CheckBox x:Name="HideMainCheck" Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="3"
                                      Content="最小化时隐藏到托盘"
                                      ToolTipService.ToolTip="最小化时隐藏到托盘" />
                        </Grid>
                    </ScrollViewer>
                </TabViewItem>

                <!-- ========== 桌面 (tabPage3) ========== -->
                <TabViewItem Header="桌面" IsClosable="False">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid Style="{StaticResource TabGridStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="150" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <CheckBox x:Name="DesktopCheck" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                                      Content="启用桌面显示本机IP标签" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="显示位置" Style="{StaticResource RowLabelStyle}" />
                            <ComboBox x:Name="DesktopLocationCombo" Grid.Row="1" Grid.Column="1" Width="180" IsEditable="False" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="0=左上角 1=右上角 2=右下角 3=左下角"
                                       Style="{StaticResource HintTextStyle}" VerticalAlignment="Center" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="偏移量x,y" Style="{StaticResource RowLabelStyle}" />
                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                <NumberBox x:Name="OffsetXBox" Width="120" Minimum="-500" Maximum="5000"
                                           SmallChange="10" LargeChange="100" SpinButtonPlacementMode="Inline"
                                           ToolTipService.ToolTip="距离横向边缘的偏移量" />
                                <NumberBox x:Name="OffsetYBox" Width="120" Minimum="-500" Maximum="5000"
                                           SmallChange="10" LargeChange="100" SpinButtonPlacementMode="Inline"
                                           ToolTipService.ToolTip="距离纵向边缘的偏移量" />
                            </StackPanel>
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="-500 - 5000，步进 10"
                                       Style="{StaticResource HintTextStyle}" VerticalAlignment="Center" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="透明度" Style="{StaticResource RowLabelStyle}" />
                            <NumberBox x:Name="OpacityBox" Grid.Row="3" Grid.Column="1" Width="180"
                                       Minimum="0" Maximum="100" SmallChange="10" LargeChange="10"
                                       SpinButtonPlacementMode="Inline"
                                       ToolTipService.ToolTip="窗体透明度，0完全透明，100不透明" />
                            <TextBlock Grid.Row="3" Grid.Column="2" Text="0 完全透明，100 不透明"
                                       Style="{StaticResource HintTextStyle}" VerticalAlignment="Center" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="IP前缀" Style="{StaticResource RowLabelStyle}"
                                       ToolTipService.ToolTip="Ping失败时，可通过此端口判断设备状态。多个端口之间用逗号分隔" />
                            <TextBox x:Name="DesktopPreBox" Grid.Row="4" Grid.Column="1" Width="180"
                                     ToolTipService.ToolTip="例如：本地IP地址为" />
                            <TextBlock Grid.Row="4" Grid.Column="2" Text="例如：本地IP地址为"
                                       Style="{StaticResource HintTextStyle}" VerticalAlignment="Center" />

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="文字颜色" Style="{StaticResource RowLabelStyle}" />
                            <Button Grid.Row="5" Grid.Column="1" Style="{StaticResource SwatchButtonStyle}"
                                    Click="OnPickDesktopForeColor"
                                    AutomationProperties.Name="文字颜色，点击选择颜色" ToolTipService.ToolTip="点击选择颜色">
                                <Border x:Name="DesktopForeSwatch" Style="{StaticResource ColorSwatchStyle}" />
                            </Button>
                            <TextBlock x:Name="DesktopForeArgbText" Grid.Row="5" Grid.Column="2"
                                       Style="{StaticResource HintTextStyle}" VerticalAlignment="Center" />

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="背景色" Style="{StaticResource RowLabelStyle}" />
                            <Button Grid.Row="6" Grid.Column="1" Style="{StaticResource SwatchButtonStyle}"
                                    Click="OnPickDesktopBgColor"
                                    AutomationProperties.Name="背景色，点击选择颜色" ToolTipService.ToolTip="点击选择颜色">
                                <Border x:Name="DesktopBgSwatch" Style="{StaticResource ColorSwatchStyle}" />
                            </Button>
                            <TextBlock x:Name="DesktopBgArgbText" Grid.Row="6" Grid.Column="2"
                                       Style="{StaticResource HintTextStyle}" VerticalAlignment="Center" />
                        </Grid>
                    </ScrollViewer>
                </TabViewItem>
            </TabView.TabItems>
        </TabView>

        <!-- ================= 配置文件位置 ================= -->
        <Grid Grid.Row="2" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="SaveStatusText" Grid.Column="0" Style="{StaticResource HintTextStyle}" VerticalAlignment="Center" />
            <TextBlock x:Name="ConfigPathText" Grid.Column="1" Style="{StaticResource HintTextStyle}"
                       TextWrapping="Wrap" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Page>
