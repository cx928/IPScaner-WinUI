<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="IPScaner.WinUI.Views.ExportDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="导出"
    PrimaryButtonText="导出"
    CloseButtonText="取消"
    DefaultButton="Primary">

    <!--
        共享导出对话框：由调用方给出建议文件名与行数，用户在五种格式里挑一种，
        再选好目标文件夹，对话框只把 (格式, 完整路径) 交回去 —— 真正写文件的是
        Core 的 ReportWriter，本对话框不碰任何一行导出数据。

        文件夹选择用 FolderPicker.PickSingleFolderAsync(windowId)：它既不弹
        Win32 模态框，也不需要第二个 ContentDialog，因此可以在本对话框已经打开
        的情况下直接调用（浏览… 按钮不会因为「一次只能开一个 ContentDialog」
        而失败，也不会去碰被禁用的所有者窗口）。
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="460">
        <StackPanel Spacing="12" MinWidth="470">

            <!-- ==================== 目标文件夹 ==================== -->
            <StackPanel Spacing="6">
                <TextBlock Text="保存位置" FontWeight="SemiBold" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="FolderBox" Grid.Column="0" Height="32"
                             AutomationProperties.Name="保存位置"
                             ToolTipService.ToolTip="导出文件将保存到该文件夹"
                             TextChanged="OnFolderTextChanged" />
                    <Button x:Name="BrowseButton" Grid.Column="1" Content="浏览…" MinWidth="76" Height="32"
                            Click="OnBrowseClick" AutomationProperties.Name="浏览…"
                            ToolTipService.ToolTip="选择其它文件夹" />
                    <Button x:Name="OpenFolderButton" Grid.Column="2" Content="打开文件夹" MinWidth="92" Height="32"
                            Click="OnOpenFolderClick" AutomationProperties.Name="打开文件夹"
                            ToolTipService.ToolTip="在资源管理器中打开该文件夹" />
                </Grid>
            </StackPanel>

            <!-- ==================== 导出格式 ==================== -->
            <StackPanel Spacing="6">
                <TextBlock Text="导出格式" FontWeight="SemiBold" />

                <RadioButton x:Name="TxtRadio" GroupName="ExportFormat" Tag="Txt" IsChecked="True"
                             Checked="OnFormatChecked" AutomationProperties.Name="文本(TXT)">
                    <StackPanel>
                        <TextBlock Text="文本(TXT)" />
                        <TextBlock Text="制表符分隔的纯文本，任何编辑器都能打开"
                                   Style="{StaticResource HintTextStyle}" />
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="CsvRadio" GroupName="ExportFormat" Tag="Csv"
                             Checked="OnFormatChecked" AutomationProperties.Name="CSV">
                    <StackPanel>
                        <TextBlock Text="CSV" />
                        <TextBlock Text="逗号分隔，UTF-8 带 BOM，Excel 双击即正确识别中文"
                                   Style="{StaticResource HintTextStyle}" />
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="XlsxRadio" GroupName="ExportFormat" Tag="Xlsx"
                             Checked="OnFormatChecked" AutomationProperties.Name="Excel(XLSX)">
                    <StackPanel>
                        <TextBlock Text="Excel(XLSX)" />
                        <TextBlock Text="真正的 Excel 工作簿，列宽与表头已排版"
                                   Style="{StaticResource HintTextStyle}" />
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="HtmlRadio" GroupName="ExportFormat" Tag="Html"
                             Checked="OnFormatChecked" AutomationProperties.Name="网页(HTML)">
                    <StackPanel>
                        <TextBlock Text="网页(HTML)" />
                        <TextBlock Text="单个 HTML 文件，带表格样式，方便直接分享"
                                   Style="{StaticResource HintTextStyle}" />
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="PdfRadio" GroupName="ExportFormat" Tag="Pdf"
                             Checked="OnFormatChecked" AutomationProperties.Name="PDF">
                    <StackPanel>
                        <TextBlock Text="PDF" />
                        <TextBlock Text="适合打印或归档的只读文档"
                                   Style="{StaticResource HintTextStyle}" />
                    </StackPanel>
                </RadioButton>
            </StackPanel>

            <!-- ==================== 预览 ==================== -->
            <Border Style="{StaticResource CardStyle}" Padding="10,8,10,8">
                <StackPanel Spacing="3">
                    <TextBlock x:Name="SummaryText" TextWrapping="Wrap" />
                    <TextBlock x:Name="PreviewText" Style="{StaticResource HintTextStyle}"
                               TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    <TextBlock x:Name="WarningText" Style="{StaticResource HintTextStyle}"
                               Foreground="DarkOrange" TextWrapping="Wrap" Visibility="Collapsed" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
