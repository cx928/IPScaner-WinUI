<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="IPScaner.WinUI.Views.BatchScanPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Required">

    <Page.Resources>
        <!-- Column headers are buttons so that clicking one sorts, exactly like the
             original's ColumnHeaderMouseClick handler (which ignored SortMode too). -->
        <Style x:Key="BatchHeaderButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="2,2,2,2" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Tighter result rows than the WinUI default (the original used 23 px). -->
        <x:Double x:Key="ListViewItemMinHeight">24</x:Double>
    </Page.Resources>

    <Grid Padding="12" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ groupBox1 (设置IP扫描范围) + gbxIPArr (IP扫描范围) ============ -->
        <Grid Grid.Row="0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="140" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="10">
                <StackPanel Spacing="6">
                    <TextBlock Text="设置IP扫描范围" Style="{StaticResource SectionHeaderStyle}" Margin="0" />

                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <RadioButton x:Name="ModeSingle" Content="单网段" GroupName="BatchMode"
                                     Tag="single" IsChecked="True" Checked="OnModeChanged"
                                     ToolTipService.ToolTip="输入 A.B.C 网段，再指定第4段的起止范围" />
                        <RadioButton x:Name="ModeRange" Content="连续IP范围" GroupName="BatchMode"
                                     Tag="range" Checked="OnModeChanged"
                                     ToolTipService.ToolTip="输入开始与结束IP，生成两者之间的全部地址" />
                        <RadioButton x:Name="ModeMask" Content="掩码位" GroupName="BatchMode"
                                     Tag="mask" Checked="OnModeChanged"
                                     ToolTipService.ToolTip="按 CIDR 掩码位生成该子网的可用主机地址" />
                    </StackPanel>

                    <!-- Mode 1 — 单网段 -->
                    <StackPanel x:Name="PanelSingle" Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="输入IP扫描段：" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox x:Name="IpPartBox" Width="96" PlaceholderText="192.168.1"
                                     ToolTipService.ToolTip="可以手动将IP地址列表复制到此处" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="开始：" Style="{StaticResource FieldLabelStyle}" />
                            <NumberBox x:Name="StartOctetBox" Width="62" Minimum="1" Maximum="255" Value="1"
                                       SpinButtonPlacementMode="Hidden" />
                            <TextBlock Text="结束：" Style="{StaticResource FieldLabelStyle}" />
                            <NumberBox x:Name="EndOctetBox" Width="62" Minimum="1" Maximum="255" Value="254"
                                       SpinButtonPlacementMode="Hidden" />
                            <Button x:Name="GenerateSingleButton" Content="生成" MinWidth="68"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Click="OnGenerateSingle" ToolTipService.ToolTip="快速生成单网段所有IP地址" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Mode 2 — 连续IP范围 -->
                    <StackPanel x:Name="PanelRange" Spacing="6" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="开始IP:" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox x:Name="StartIpBox" Width="112" PlaceholderText="192.168.0.1"
                                     ToolTipService.ToolTip="开始ip，例如192.168.0.1" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="结束IP:" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox x:Name="EndIpBox" Width="112" PlaceholderText="192.168.1.254"
                                     ToolTipService.ToolTip="结束IP, 例如192.168.1.254" />
                            <Button x:Name="GenerateRangeButton" Content="生成" MinWidth="68"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Click="OnGenerateRange" ToolTipService.ToolTip="批量生成连续的IP地址" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Mode 3 — 掩码位 -->
                    <StackPanel x:Name="PanelMask" Spacing="6" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="IP/掩码位:" Style="{StaticResource FieldLabelStyle}" />
                            <NumberBox x:Name="MaskIp1" Width="58" Minimum="0" Maximum="255" Value="192"
                                       SpinButtonPlacementMode="Hidden" />
                            <NumberBox x:Name="MaskIp2" Width="58" Minimum="0" Maximum="255" Value="168"
                                       SpinButtonPlacementMode="Hidden" />
                            <NumberBox x:Name="MaskIp3" Width="58" Minimum="0" Maximum="255" Value="0"
                                       SpinButtonPlacementMode="Hidden" />
                            <NumberBox x:Name="MaskIp4" Width="58" Minimum="0" Maximum="255" Value="1"
                                       SpinButtonPlacementMode="Hidden" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="/" Style="{StaticResource FieldLabelStyle}" Margin="2,0,2,0" />
                            <NumberBox x:Name="MaskBitsBox" Width="58" Minimum="1" Maximum="30" Value="24"
                                       SpinButtonPlacementMode="Hidden"
                                       ToolTipService.ToolTip="子网掩码的位数，值在1~30之间" />
                            <Button x:Name="GenerateMaskButton" Content="生成" MinWidth="68"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Click="OnGenerateMask" ToolTipService.ToolTip="批量生成多网段中的连续IP地址" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- gbxIPArr: the one-IP-per-line list that 开始扫描 actually reads. -->
            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="10">
                <Grid RowSpacing="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="RangeCaption" Text="IP扫描范围 (0)" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBox x:Name="RangeBox" Grid.Row="1" AcceptsReturn="True" TextWrapping="NoWrap"
                             IsSpellCheckEnabled="False" FontSize="12" MaxHeight="112"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             TextChanged="OnRangeTextChanged"
                             ToolTipService.ToolTip="可以手动将IP地址列表复制到此处" />
                </Grid>
            </Border>
        </Grid>

        <!-- ============ gbxResult / dgvResult ============ -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="10">
            <Grid RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="ResultCaption" Text="网络扫描结果" FontWeight="SemiBold" />

                <!-- Rows are realised in code (see BatchRow) so the status colours are
                     applied directly. The header lives inside the ListView so that it
                     always shares the rows' exact width — including any scrollbar. -->
                <ListView x:Name="ResultList" Grid.Row="1" SelectionMode="Single" Padding="0"
                          ScrollViewer.HorizontalScrollMode="Disabled"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>

                    <ListView.Header>
                        <Grid Padding="8,2,8,2" ColumnSpacing="6" BorderThickness="0,0,0,1"
                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                              ToolTipService.ToolTip="点各个列头，可升序或降序排序">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.3*" />
                                <ColumnDefinition Width="1.3*" />
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="0.7*" />
                                <ColumnDefinition Width="0.8*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="HeadIp" Grid.Column="0" Content="IP" Tag="ip"
                                    Style="{StaticResource BatchHeaderButtonStyle}" Click="OnHeaderClick" />
                            <Button x:Name="HeadHost" Grid.Column="1" Content="主机名" Tag="host"
                                    Style="{StaticResource BatchHeaderButtonStyle}" Click="OnHeaderClick" />
                            <Button x:Name="HeadMac" Grid.Column="2" Content="MAC" Tag="mac"
                                    Style="{StaticResource BatchHeaderButtonStyle}" Click="OnHeaderClick" />
                            <Button x:Name="HeadMemo" Grid.Column="3" Content="备注" Tag="memo"
                                    Style="{StaticResource BatchHeaderButtonStyle}" Click="OnHeaderClick" />
                            <Button x:Name="HeadStatus" Grid.Column="4" Content="状态" Tag="status"
                                    Style="{StaticResource BatchHeaderButtonStyle}" Click="OnHeaderClick" />
                            <Button x:Name="HeadTime" Grid.Column="5" Content="时间" Tag="time"
                                    Style="{StaticResource BatchHeaderButtonStyle}" Click="OnHeaderClick" />
                        </Grid>
                    </ListView.Header>
                </ListView>
            </Grid>
        </Border>

        <!-- ============ panel2: action bar ============ -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="10,8,10,8">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <CheckBox x:Name="IntervalCheck" Content="定时扫描" MinWidth="0"
                          Checked="OnIntervalToggled" Unchecked="OnIntervalToggled"
                          ToolTipService.ToolTip="定时执行批量扫描任务" />
                <NumberBox x:Name="IntervalMinutesBox" Width="60" Minimum="1" Maximum="59" Value="1"
                           SpinButtonPlacementMode="Hidden"
                           ToolTipService.ToolTip="定时执行批量扫描任务的间隔时长" />
                <TextBlock Text="分" Style="{StaticResource FieldLabelStyle}" Margin="0,0,6,0" />
                <Button x:Name="StartButton" Content="开始扫描" MinWidth="78"
                        Style="{StaticResource AccentButtonStyle}" Click="OnStartClick" />
                <Button x:Name="StopButton" Content="停止" MinWidth="62" IsEnabled="False" Click="OnStopClick" />
                <Button Content="清空日志" MinWidth="78" Click="OnClearClick"
                        ToolTipService.ToolTip="清空IP扫描范围和结果数据" />
                <Button Content="导出结果" MinWidth="78" Click="OnExportClick"
                        ToolTipService.ToolTip="导出为 CSV 与 Excel (.xlsx)" />
            </StackPanel>
        </Border>

        <!-- ============ statusStrip1 ============ -->
        <Grid Grid.Row="3" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Text="准备就绪" Style="{StaticResource StatusTextStyle}" />
            <TextBlock x:Name="StatusNextText" Grid.Column="1" Text="-" Style="{StaticResource StatusTextStyle}" />
        </Grid>
    </Grid>
</Page>
