<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="IPScaner.WinUI.Views.PortScanPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Required">

    <Grid Padding="16,10,16,10" RowSpacing="8" SizeChanged="OnPageSizeChanged">
        <Grid.RowDefinitions>
            <!-- The form needs more room than a short window has, so it scrolls inside a
                 height cap that follows the page size (see UpdateFormHeight), while the
                 result grid keeps the rest of the window — and all of it once the window
                 is tall enough for the form to fit at its natural height. -->
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="120" />
        </Grid.RowDefinitions>

        <!-- ============ groupBox3 + groupBox2 — the four scan shapes ============ -->
        <ScrollViewer x:Name="FormScroller" Grid.Row="0" MaxHeight="320"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="8">

                <!-- groupBox3 — 单个IP批量端口扫描 -->
                <Border Style="{StaticResource CardStyle}" Padding="10,8,10,8">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="单个IP批量端口扫描" Style="{StaticResource SectionHeaderStyle}" Margin="0" />
                            <TextBlock x:Name="TimeoutText" Style="{StaticResource HintTextStyle}"
                                       VerticalAlignment="Center" Text="TCP超时毫秒：" />
                        </StackPanel>

                        <!-- shape 1: one host, inclusive port range from the two spinners -->
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <TextBlock Text="IP或域名" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox x:Name="HostBox" Width="70" Text="127.0.0.1"
                                     AutomationProperties.Name="IP或域名"
                                     PlaceholderText="填写完整IP，比如127.0.0.1"
                                     ToolTipService.ToolTip="单个IP地址或域名，例如 127.0.0.1 或 www.example.com" />
                            <TextBlock Text="端口：" Style="{StaticResource FieldLabelStyle}" />
                            <NumberBox x:Name="StartPortBox" Width="72" Value="1" Minimum="1" Maximum="65535"
                                       SmallChange="1" SpinButtonPlacementMode="Hidden"
                                       AutomationProperties.Name="开始端口"
                                       ToolTipService.ToolTip="开始端口号，从1开始" />
                            <TextBlock Text="-" Style="{StaticResource FieldLabelStyle}" />
                            <NumberBox x:Name="EndPortBox" Width="72" Value="65535" Minimum="1" Maximum="65535"
                                       SmallChange="1" SpinButtonPlacementMode="Hidden"
                                       AutomationProperties.Name="结束端口"
                                       ToolTipService.ToolTip="最大端口号，不大于65535，可为空值（留空表示与开始端口相同）" />
                            <Button x:Name="ScanRangeButton" Content="扫描" MinWidth="56" Height="32"
                                    Click="OnScanRangeClick" AutomationProperties.Name="扫描端口范围"
                                    ToolTipService.ToolTip="扫描该IP的整个端口范围" />
                            <Button x:Name="StopRangeButton" Content="停止" MinWidth="56" Height="32"
                                    IsEnabled="False" Click="OnStopClick" AutomationProperties.Name="停止端口范围扫描" />
                        </StackPanel>

                        <!-- shape 2: one host, explicit port list -->
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <TextBlock Text="多个端口范围:" Style="{StaticResource FieldLabelStyle}"
                                       ToolTipService.ToolTip="多个端口之间用逗号分隔" />
                            <TextBox x:Name="PortListBox" Width="200" Text="80,443"
                                     AutomationProperties.Name="单个IP端口列表"
                                     ToolTipService.ToolTip="用逗号、顿号或空格分隔，支持范围（如 80,443,1000-2000）以及 all / 全部端口" />
                            <Button x:Name="ScanListButton" Content="扫描" MinWidth="56" Height="32"
                                    Click="OnScanListClick" AutomationProperties.Name="扫描端口列表"
                                    ToolTipService.ToolTip="扫描该IP的指定端口" />
                            <Button x:Name="StopListButton" Content="停止" MinWidth="56" Height="32"
                                    IsEnabled="False" Click="OnStopClick" AutomationProperties.Name="停止端口列表扫描" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- groupBox2 — IP段多个端口扫描 -->
                <Border Style="{StaticResource CardStyle}" Padding="10,8,10,8">
                    <StackPanel Spacing="4">
                        <TextBlock Text="IP段多个端口扫描 (结束值可为空)" Style="{StaticResource SectionHeaderStyle}" Margin="0" />

                        <!-- shape 3: A.B.C prefix + last-octet range + port list -->
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <TextBlock Text="IP网段：" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox x:Name="SegmentBox" Width="62" Text="127.0.0."
                                     AutomationProperties.Name="IP网段"
                                     PlaceholderText="填写IP段，比如127.0.0."
                                     ToolTipService.ToolTip="前三段IP，例如 192.168.1" />
                            <TextBlock Text="开始：" Style="{StaticResource FieldLabelStyle}" />
                            <NumberBox x:Name="StartIpBox" Width="42" Value="1" Minimum="1" Maximum="255"
                                       SmallChange="1" SpinButtonPlacementMode="Compact"
                                       AutomationProperties.Name="开始IP"
                                       ToolTipService.ToolTip="起始IP地址" />
                            <TextBlock Text="结束：" Style="{StaticResource FieldLabelStyle}" />
                            <NumberBox x:Name="EndIpBox" Width="42" Value="254" Minimum="1" Maximum="255"
                                       SmallChange="1" SpinButtonPlacementMode="Compact"
                                       AutomationProperties.Name="结束IP"
                                       ToolTipService.ToolTip="最大IP地址，可为空值（留空表示与开始相同）" />
                            <TextBlock Text="端口：" Style="{StaticResource FieldLabelStyle}"
                                       ToolTipService.ToolTip="多个端口之间用逗号分隔" />
                            <TextBox x:Name="SegmentPortsBox" Width="84" Text="25,80,443"
                                     AutomationProperties.Name="IP段端口列表"
                                     ToolTipService.ToolTip="自动加载上次扫描的端口；支持范围（如 80,443,1000-2000）以及 all / 全部端口" />
                        </StackPanel>

                        <!-- shape 4: IP/掩码位 (CIDR) -->
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <TextBlock Text="IP/掩码位:" Style="{StaticResource FieldLabelStyle}" />
                            <NumberBox x:Name="Ip1Box" Width="48" Value="192" Minimum="1" Maximum="255"
                                       SmallChange="1" SpinButtonPlacementMode="Compact" AutomationProperties.Name="IP第1段" />
                            <TextBlock Text="." Style="{StaticResource FieldLabelStyle}" />
                            <NumberBox x:Name="Ip2Box" Width="48" Value="168" Minimum="0" Maximum="255"
                                       SmallChange="1" SpinButtonPlacementMode="Compact" AutomationProperties.Name="IP第2段" />
                            <TextBlock Text="." Style="{StaticResource FieldLabelStyle}" />
                            <NumberBox x:Name="Ip3Box" Width="48" Value="0" Minimum="0" Maximum="255"
                                       SmallChange="1" SpinButtonPlacementMode="Compact" AutomationProperties.Name="IP第3段" />
                            <TextBlock Text="." Style="{StaticResource FieldLabelStyle}" />
                            <NumberBox x:Name="Ip4Box" Width="48" Value="1" Minimum="0" Maximum="255"
                                       SmallChange="1" SpinButtonPlacementMode="Compact" AutomationProperties.Name="IP第4段" />
                            <TextBlock Text="/" Style="{StaticResource FieldLabelStyle}" />
                            <NumberBox x:Name="BitsBox" Width="48" Value="24" Minimum="1" Maximum="30"
                                       SmallChange="1" SpinButtonPlacementMode="Compact" AutomationProperties.Name="掩码位"
                                       ToolTipService.ToolTip="子网掩码的位数，值在1~30之间" />
                        </StackPanel>

                        <!-- the two button pairs of the IP段 shapes, labelled so the pair
                             each one belongs to is unambiguous -->
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <TextBlock Text="IP段：" Style="{StaticResource FieldLabelStyle}" />
                            <Button x:Name="ScanSegmentButton" Content="扫描" MinWidth="56" Height="32"
                                    Click="OnScanSegmentClick" AutomationProperties.Name="扫描IP段"
                                    ToolTipService.ToolTip="扫描该IP段上指定的端口" />
                            <Button x:Name="StopSegmentButton" Content="停止" MinWidth="56" Height="32"
                                    IsEnabled="False" Click="OnStopClick" AutomationProperties.Name="停止IP段扫描" />
                            <TextBlock Text="掩码位：" Style="{StaticResource FieldLabelStyle}" Margin="8,0,5,0" />
                            <Button x:Name="ScanCidrButton" Content="扫描" MinWidth="56" Height="32"
                                    Click="OnScanCidrClick" AutomationProperties.Name="扫描掩码位"
                                    ToolTipService.ToolTip="扫描该子网的指定端口" />
                            <Button x:Name="StopCidrButton" Content="停止" MinWidth="56" Height="32"
                                    IsEnabled="False" Click="OnStopClick" AutomationProperties.Name="停止掩码位扫描" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ============ gbxResult — 端口扫描结果 ============ -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="10,8,10,10">
            <Grid RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="端口扫描结果" Style="{StaticResource SectionHeaderStyle}"
                               Margin="0" VerticalAlignment="Center" />
                    <CheckBox x:Name="ShowClosedToggle" Content="显示关闭端口" VerticalAlignment="Center"
                              AutomationProperties.Name="显示关闭端口" MinWidth="0"
                              ToolTipService.ToolTip="开启后同时记录未开放的端口（原版只记录开放的端口）" />
                    <Button x:Name="CopyButton" Content="复制" Click="OnCopyClick" IsEnabled="False" Height="32"
                            AutomationProperties.Name="复制扫描结果"
                            ToolTipService.ToolTip="把扫描日志逐行复制到剪贴板" />
                    <TextBlock x:Name="ProgressText" Style="{StaticResource HintTextStyle}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="尚未扫描" />
                </StackPanel>

                <ListView x:Name="ResultList" Grid.Row="1" SelectionMode="None"
                          ItemsSource="{x:Bind Rows}">
                    <ListView.HeaderTemplate>
                        <DataTemplate>
                            <Grid Padding="10,6" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="76" />
                                    <ColumnDefinition Width="132" />
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="时间" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="IP" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="2" Text="端口" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="3" Text="服务" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="4" Text="状态" FontWeight="SemiBold" />
                            </Grid>
                        </DataTemplate>
                    </ListView.HeaderTemplate>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="10,4" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="76" />
                                    <ColumnDefinition Width="132" />
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Time}" />
                                <TextBlock Grid.Column="1" Text="{Binding IP}" />
                                <TextBlock Grid.Column="2" Text="{Binding Port}" />
                                <TextBlock Grid.Column="3" Text="{Binding Service}" />
                                <TextBlock Grid.Column="4" Text="{Binding Status}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Page>



