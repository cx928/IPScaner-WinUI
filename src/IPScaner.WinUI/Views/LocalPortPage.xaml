<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="IPScaner.WinUI.Views.LocalPortPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:IPScaner.Core.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Required">

    <Grid Padding="16,10,16,10" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="170" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ groupBox1 — 查询 ============ -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="10,8,10,8">
            <StackPanel Spacing="4">
                <TextBlock Text="查询（筛选条件：端口，PID，进程名，路径）"
                           Style="{StaticResource SectionHeaderStyle}" Margin="0" />

                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="筛选条件:" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox x:Name="FilterBox" Width="170" KeyDown="OnFilterKeyDown"
                             AutomationProperties.Name="筛选条件"
                             ToolTipService.ToolTip="端口与PID精确匹配，进程名与路径包含匹配；按回车执行筛选" />
                    <Button x:Name="FilterButton" Content="筛选" MinWidth="62" Height="32"
                            Style="{StaticResource AccentButtonStyle}" Click="OnFilterClick"
                            AutomationProperties.Name="筛选" />
                    <Button x:Name="ReloadButton" Content="刷新端口列表" MinWidth="116" Height="32"
                            Click="OnReloadClick" AutomationProperties.Name="刷新端口列表"
                            ToolTipService.ToolTip="重新读取本机全部 TCP / UDP 端口" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="反向筛选:" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox x:Name="ExceptFilterBox" Width="170" KeyDown="OnFilterKeyDown"
                             AutomationProperties.Name="反向筛选"
                             ToolTipService.ToolTip="端口或PID相等、进程名或路径包含时排除该行；按回车执行筛选" />
                    <Button x:Name="KillButton" Content="结束进程" MinWidth="76" Height="32"
                            Click="OnKillClick" IsEnabled="False" AutomationProperties.Name="结束进程"
                            ToolTipService.ToolTip="结束当前选中行所属的进程（也可以双击某一行）" />
                    <Button x:Name="OpenFolderButton" Content="打开文件目录" MinWidth="104" Height="32"
                            Click="OnOpenFolderClick" IsEnabled="False" AutomationProperties.Name="打开文件目录"
                            ToolTipService.ToolTip="打开进程所在目录（原版的 双击【进程所在路径】）" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="6">
                    <CheckBox x:Name="TcpToggle" Content="包含TCP" IsChecked="True" Click="OnProtocolToggled"
                              AutomationProperties.Name="包含TCP" MinWidth="0"
                              ToolTipService.ToolTip="包含 TCP 端点" />
                    <CheckBox x:Name="UdpToggle" Content="包含UDP" IsChecked="True" Click="OnProtocolToggled"
                              AutomationProperties.Name="包含UDP" MinWidth="0"
                              ToolTipService.ToolTip="包含 UDP 端点" />
                    <CheckBox x:Name="Ipv6Toggle" Content="包含IPv6" IsChecked="False" Click="OnProtocolToggled"
                              AutomationProperties.Name="包含IPv6" MinWidth="0"
                              ToolTipService.ToolTip="原版的 netstat 正则只认 IPv4 地址，IPv6 行完全不可见" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ============ statistics caption ============ -->
        <Grid Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="SummaryText" Grid.Column="0" Text="系统端口列表" Margin="0"
                       Style="{StaticResource SectionHeaderStyle}" />
            <TextBlock x:Name="FilterHintText" Grid.Column="1" Style="{StaticResource HintTextStyle}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </Grid>

        <!-- ============ gbxResult — 系统端口列表 ============ -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="4">
            <Grid>
                <ListView x:Name="PortList" SelectionMode="Single" SelectionChanged="OnSelectionChanged">
                    <ListView.HeaderTemplate>
                        <DataTemplate>
                            <Grid Padding="10,6" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48" />
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="72" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="协议" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="端口" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="2" Text="PID" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="3" Text="进程名" FontWeight="SemiBold"
                                           ToolTipService.ToolTip="进程名与路径为空表示该行进程已退出或权限不足（原版会直接隐藏这些行）" />
                                <TextBlock Grid.Column="4" Text="进程所在路径" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="5" Text="状态" FontWeight="SemiBold"
                                           ToolTipService.ToolTip="原版丢弃了 netstat 的状态列，本页显示 Core 本地化后的 TCP 状态" />
                            </Grid>
                        </DataTemplate>
                    </ListView.HeaderTemplate>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:LocalPortInfo">
                            <Grid Padding="10,4" ColumnSpacing="10"
                                  DoubleTapped="OnRowDoubleTapped" RightTapped="OnRowRightTapped"
                                  ToolTipService.ToolTip="双击结束该进程，右键查看更多操作">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48" />
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="72" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Bind Protocol}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind LocalPort}" />
                                <TextBlock Grid.Column="2" Text="{x:Bind Pid}" Foreground="DarkOrange" />
                                <TextBlock Grid.Column="3" Text="{x:Bind ProcessName}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="4" Text="{x:Bind ProcessPath}" TextTrimming="CharacterEllipsis"
                                           ToolTipService.ToolTip="{x:Bind ProcessPath}" />
                                <TextBlock Grid.Column="5" Text="{x:Bind State}" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock x:Name="EmptyHintText" Style="{StaticResource HintTextStyle}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="Collapsed" Text="没有符合条件的记录。" />
            </Grid>
        </Border>

        <!-- ============ statusStrip1 ============ -->
        <Grid Grid.Row="3" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Grid.Column="0" Style="{StaticResource StatusTextStyle}" Text="程序已就绪" />
            <TextBlock Grid.Column="1" Style="{StaticResource StatusTextStyle}" Foreground="DarkOrange"
                       Text="双击任意行可结束进程，右键可打开进程目录" />
        </Grid>
    </Grid>
</Page>

