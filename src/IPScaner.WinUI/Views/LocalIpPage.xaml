<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="IPScaner.WinUI.Views.LocalIpPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:IPScaner.Core.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        修改本地IP — the page form of the original FormLocalIP (title 一键设置IP).
        Layout notes:
        * the original form was captured at 175% DPI (AutoScaleDimensions (11F,21F),
          RE spec A.1), so the raw designer coordinates were re-laid-out here rather
          than copied; the control set, captions and order are unchanged;
        * the shell window is 1180x820 physical pixels, i.e. only ~787x547 effective
          units at 150% DPI, which leaves roughly 480 units of usable width per card.
          Every fixed width below is chosen to fit that budget.
    -->
    <Grid Padding="16,12,16,12" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==================== adapter + current adapter context ==================== -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}">
            <StackPanel Spacing="10">

                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="当前IP：" Style="{StaticResource FieldLabelStyle}" />
                    <!-- The original refreshed the adapter list when the blue IP label was
                         clicked; kept here as the same affordance (plus an explicit button). -->
                    <HyperlinkButton x:Name="CurrentIpLink" Content="—" Padding="2,0,2,0"
                                     Click="OnRefreshAdaptersClick"
                                     ToolTipService.ToolTip="点击重新枚举网卡" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="适配器：" Style="{StaticResource FieldLabelStyle}" />
                    <ComboBox x:Name="AdapterCombo" Width="260" PlaceholderText="正在读取网卡…"
                              ToolTipService.ToolTip="切换多个网卡"
                              SelectionChanged="OnAdapterSelected" />
                    <Button Content="刷新网卡" Click="OnRefreshAdaptersClick"
                            ToolTipService.ToolTip="重新枚举本机网卡" />
                    <ProgressRing x:Name="BusyRing" Width="20" Height="20" IsActive="False" />
                </StackPanel>

                <!-- read-only context for the selection: 名称 / IP / 掩码 / 网关 / MAC / DHCP -->
                <Grid ColumnSpacing="12" RowSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="名称：" Opacity="0.8" />
                    <TextBlock x:Name="DetailName" Grid.Row="0" Grid.Column="1" Text="—"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="MAC：" Opacity="0.8" />
                    <TextBlock x:Name="DetailMac" Grid.Row="0" Grid.Column="3" Text="—"
                               TextTrimming="CharacterEllipsis" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="IP：" Opacity="0.8" />
                    <TextBlock x:Name="DetailIp" Grid.Row="1" Grid.Column="1" Text="—" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="掩码：" Opacity="0.8" />
                    <TextBlock x:Name="DetailMask" Grid.Row="1" Grid.Column="3" Text="—" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="网关：" Opacity="0.8" />
                    <TextBlock x:Name="DetailGateway" Grid.Row="2" Grid.Column="1" Text="—" />
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="DHCP：" Opacity="0.8" />
                    <TextBlock x:Name="DetailDhcp" Grid.Row="2" Grid.Column="3" Text="—" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="DNS：" Opacity="0.8" />
                    <TextBlock x:Name="DetailDns" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3"
                               Text="—" TextWrapping="Wrap" />
                </Grid>

                <InfoBar x:Name="AdapterHintBar" IsOpen="False" Severity="Informational"
                         Title="没有可用的网卡"
                         Message="未枚举到以太网或无线网卡（VMware 虚拟网卡会被跳过）。请确认网卡已启用后点击【刷新网卡】。" />
            </StackPanel>
        </Border>

        <!-- ==================== elevation warning ==================== -->
        <InfoBar x:Name="ElevationBar" Grid.Row="1" IsOpen="False" Severity="Warning"
                 Title="需要管理员权限"
                 Message="修改 IP 地址与 DNS 服务器需要以管理员身份运行，否则 netsh 会因访问被拒绝而设置失败。">
            <InfoBar.ActionButton>
                <Button Content="以管理员身份重启" Click="OnRestartElevatedClick" />
            </InfoBar.ActionButton>
        </InfoBar>

        <!-- ==================== form ==================== -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="10">

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="IP地址" Style="{StaticResource SectionHeaderStyle}" />

                        <RadioButton x:Name="IpDhcpRadio" GroupName="IpMode"
                                     Content="自动获取 IP地址" Checked="OnIpModeChanged" />
                        <RadioButton x:Name="IpStaticRadio" GroupName="IpMode"
                                     Content="使用下面的 IP地址" Checked="OnIpModeChanged" />

                        <Grid ColumnSpacing="10" RowSpacing="6" Margin="24,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="240" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="IP地址："
                                       Style="{StaticResource FieldLabelStyle}" />
                            <TextBox x:Name="SetIpBox" Grid.Row="0" Grid.Column="1"
                                     PlaceholderText="例如 192.168.1.100"
                                     TextChanged="OnIpTextChanged" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="子网掩码："
                                       Style="{StaticResource FieldLabelStyle}" />
                            <TextBox x:Name="MaskBox" Grid.Row="1" Grid.Column="1" Text="255.255.255.0"
                                     PlaceholderText="例如 255.255.255.0" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="网关："
                                       Style="{StaticResource FieldLabelStyle}" />
                            <TextBox x:Name="GatewayBox" Grid.Row="2" Grid.Column="1"
                                     PlaceholderText="例如 192.168.1.1"
                                     TextChanged="OnGatewayTextChanged" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="DNS服务器" Style="{StaticResource SectionHeaderStyle}" />

                        <RadioButton x:Name="DnsAutoRadio" GroupName="DnsMode"
                                     Content="自动获取 DNS服务器地址" Checked="OnDnsModeChanged" />
                        <RadioButton x:Name="DnsStaticRadio" GroupName="DnsMode"
                                     Content="使用下面的 DNS服务器地址" Checked="OnDnsModeChanged" />

                        <Grid ColumnSpacing="10" RowSpacing="6" Margin="24,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- the double space is the original caption, spec A.1 -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="DNS 服务器："
                                       Style="{StaticResource FieldLabelStyle}" />
                            <TextBox x:Name="DnsBox" Grid.Row="0" Grid.Column="1"
                                     PlaceholderText="多个DNS用逗号分隔" />
                            <ComboBox x:Name="DnsPresetCombo" Grid.Row="0" Grid.Column="2"
                                      PlaceholderText="常用"
                                      ToolTipService.ToolTip="选择后填入 DNS 服务器"
                                      SelectionChanged="OnDnsPresetSelected" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                                       Style="{StaticResource HintTextStyle}"
                                       Text="可填写多个DNS，用逗号或空格分隔，例如 223.5.5.5,119.29.29.29" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="历史地址" Style="{StaticResource SectionHeaderStyle}" />
                            <Button x:Name="ApplyHistoryButton" Grid.Column="1" Content="应用到当前网卡"
                                    Click="OnApplyHistoryClick"
                                    ToolTipService.ToolTip="把所选历史记录填入上方表单，不会立即修改网卡（仍需点击【保存设置】）" />
                        </Grid>

                        <!-- Two compact lines per record: a five-column table does not fit
                             the shell window (~480 units), and the original only listed the
                             IP anyway. -->
                        <ListView x:Name="HistoryList" MaxHeight="180" SelectionMode="Single"
                                  ToolTipService.ToolTip="历史修改记录都在这里"
                                  SelectionChanged="OnHistorySelectionChanged">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:AdapterInfo">
                                    <StackPanel Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind Name}" Width="130"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind IP}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <TextBlock Text="掩码" FontSize="12" Opacity="0.7" />
                                            <TextBlock Text="{x:Bind SubnetMask}" FontSize="12" Opacity="0.7" />
                                            <TextBlock Text="网关" FontSize="12" Opacity="0.7" />
                                            <TextBlock Text="{x:Bind Gateway}" FontSize="12" Opacity="0.7" />
                                            <TextBlock Text="DNS" FontSize="12" Opacity="0.7" />
                                            <TextBlock Text="{x:Bind Dns}" FontSize="12" Opacity="0.7"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <TextBlock x:Name="HistoryHintText" Style="{StaticResource HintTextStyle}"
                                   Text="选中一条记录即可填入表单（不会自动应用），确认无误后点击【保存设置】。" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ==================== actions ==================== -->
        <StackPanel Grid.Row="3" Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="SaveButton" Content="保存设置" MinWidth="120"
                        Style="{StaticResource AccentButtonStyle}" Click="OnSaveClick">
                    <Button.KeyboardAccelerators>
                        <!-- the original form's AcceptButton: Enter applies -->
                        <KeyboardAccelerator Key="Enter" />
                    </Button.KeyboardAccelerators>
                </Button>
                <Button x:Name="ResetButton" Content="重置" MinWidth="96" Click="OnResetClick"
                        ToolTipService.ToolTip="用当前网卡的实际信息重新填充表单" />
            </StackPanel>
            <TextBlock x:Name="StatusText" Style="{StaticResource HintTextStyle}"
                       TextTrimming="CharacterEllipsis" />
        </StackPanel>
    </Grid>
</Page>
