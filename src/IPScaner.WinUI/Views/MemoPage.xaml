<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="IPScaner.WinUI.Views.MemoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Required">

    <!--
        备注管理 — one row per entry of AppServices.Current.Memo (IPScanerMemo.dat).
        Replaces the original FormMemoManager dialog; the column widths below are
        duplicated in MemoPage.xaml.cs (IndexColumnWidth / KeyColumnWidth /
        TypeColumnWidth) because the rows are built in code.

        The layout has to survive a narrow logical width (the shell window is
        1180x820 *physical* pixels, i.e. ~787x547 at 150% scaling), so the toolbar
        is stacked in three compact rows instead of one long strip.
    -->
    <Grid Padding="16,12,16,12" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================= query + actions ================= -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}">
            <StackPanel Spacing="8">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="备注信息管理"
                               Style="{StaticResource SectionHeaderStyle}" Margin="0" />
                    <TextBlock Grid.Column="1" Style="{StaticResource HintTextStyle}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Text="IP或MAC只填一个即可。若同时存在，以MAC为主。" />
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="查询条件" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox x:Name="FilterBox" Width="180"
                             PlaceholderText="查询IP或备注信息"
                             AutomationProperties.Name="查询IP或备注信息"
                             ToolTipService.ToolTip="查询IP或备注信息"
                             TextChanged="OnFilterChanged" />
                    <TextBlock x:Name="FilterHintText" Style="{StaticResource HintTextStyle}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="AddButton" Content="新增" MinWidth="60" Click="OnAddClick"
                            AutomationProperties.Name="新增"
                            ToolTipService.ToolTip="新增一条备注（IP或MAC）" />
                    <Button x:Name="EditButton" Content="修改" MinWidth="60" IsEnabled="False" Click="OnEditClick"
                            AutomationProperties.Name="修改"
                            ToolTipService.ToolTip="修改选中行的备注（双击行亦可）" />
                    <Button x:Name="DeleteButton" Content="删除" MinWidth="60" IsEnabled="False" Click="OnDeleteClick"
                            AutomationProperties.Name="删除"
                            ToolTipService.ToolTip="删除选中的备注" />
                    <Button x:Name="ImportButton" Content="从剪贴板导入" MinWidth="120" Click="OnImportClick"
                            AutomationProperties.Name="从剪贴板导入"
                            ToolTipService.ToolTip="导入剪贴板数据，格式为192.168.0.1=监控服务器" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ================= data list ================= -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="12,8,12,12">
            <Grid RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="数据列表" FontWeight="SemiBold" />

                <Grid Grid.Row="1" Padding="8,0,8,4" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="序号" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="键(IP或MAC)" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="2" Text="类型" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="3" Text="备注" FontWeight="SemiBold" />
                </Grid>

                <Border Grid.Row="2" Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <ListView x:Name="MemoList" Grid.Row="3"
                          SelectionMode="Single"
                          SelectionChanged="OnSelectionChanged"
                          DoubleTapped="OnListDoubleTapped" />

                <TextBlock x:Name="EmptyHint" Grid.Row="3" MaxWidth="460"
                           Style="{StaticResource HintTextStyle}"
                           TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="Collapsed" />
            </Grid>
        </Border>

        <!-- ================= status + file actions ================= -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="12,8">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock x:Name="StatusText" Style="{StaticResource StatusTextStyle}" />
                    <TextBlock x:Name="PathText" Style="{StaticResource HintTextStyle}" />
                    <TextBlock x:Name="ResolveText" Style="{StaticResource HintTextStyle}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                    <Button x:Name="SaveButton" Content="保存" MinWidth="60" Click="OnSaveClick"
                            AutomationProperties.Name="保存备注文件"
                            ToolTipService.ToolTip="立即写入 IPScanerMemo.dat（新增/修改/删除/导入后会自动保存）" />
                    <Button x:Name="ClearButton" Content="清空全部" MinWidth="84" Click="OnClearAllClick"
                            AutomationProperties.Name="清空全部"
                            ToolTipService.ToolTip="删除全部备注，并把备注文件写为空文件" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
