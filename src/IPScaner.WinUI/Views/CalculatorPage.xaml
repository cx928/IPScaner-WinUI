<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="IPScaner.WinUI.Views.CalculatorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <!-- The original laid every row out on a fixed 52 px pitch starting at
             x=78, with 45x23 read-only boxes. Those boxes clipped the 10-digit
             "可用地址" of a /0, so the port widens them (see docs/re/03 §B.1.2). -->
        <Style x:Key="RowLabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Width" Value="96" />
        </Style>
        <Style x:Key="OctetOutStyle" TargetType="TextBox">
            <Setter Property="Width" Value="72" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
        <Style x:Key="DotStyle" TargetType="TextBlock">
            <Setter Property="Text" Value="." />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
    </Page.Resources>

    <ScrollViewer Padding="28,24,28,24" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="14" MaxWidth="820" HorizontalAlignment="Left">

            <!-- ================= title ================= -->
            <StackPanel Spacing="4">
                <TextBlock Text="网络和IP地址计算器" FontSize="18" FontWeight="Bold" />
                <TextBlock Text="显示网络，广播，第一个和最后一个给定的网络地址" Style="{StaticResource HintTextStyle}" />
            </StackPanel>

            <!-- ================= input ================= -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="IP/掩码位:" Style="{StaticResource RowLabelStyle}" />

                        <NumberBox x:Name="Ip1Box" Width="76" Minimum="0" Maximum="255"
                                   SpinButtonPlacementMode="Compact" Value="192" />
                        <TextBlock Style="{StaticResource DotStyle}" />
                        <NumberBox x:Name="Ip2Box" Width="76" Minimum="0" Maximum="255"
                                   SpinButtonPlacementMode="Compact" Value="168" />
                        <TextBlock Style="{StaticResource DotStyle}" />
                        <NumberBox x:Name="Ip3Box" Width="76" Minimum="0" Maximum="255"
                                   SpinButtonPlacementMode="Compact" Value="0" />
                        <TextBlock Style="{StaticResource DotStyle}" />
                        <NumberBox x:Name="Ip4Box" Width="76" Minimum="0" Maximum="255"
                                   SpinButtonPlacementMode="Compact" Value="1" />

                        <TextBlock Text="/" Style="{StaticResource DotStyle}" Margin="4,0,0,0" />
                        <TextBox x:Name="MaskBox" Width="130" Text="24"
                                 ToolTipService.ToolTip="0 - 32 位的掩码位数，也可以直接填点分掩码，例如 255.255.255.0" />

                        <Button Content="计算" Click="OnCalcClick" Style="{StaticResource AccentButtonStyle}"
                                MinWidth="76" Margin="6,0,0,0">
                            <Button.KeyboardAccelerators>
                                <!-- the original's AcceptButton made Enter run 计算 -->
                                <KeyboardAccelerator Key="Enter" />
                            </Button.KeyboardAccelerators>
                        </Button>
                    </StackPanel>

                    <TextBlock Style="{StaticResource HintTextStyle}"
                               Text="掩码位支持 0 - 32；填点分掩码（如 255.255.255.0）或 /24 也可以，按【计算】后会自动换算成位数。" />
                </StackPanel>
            </Border>

            <!-- ================= results ================= -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="计算结果" Style="{StaticResource SectionHeaderStyle}"
                                   VerticalAlignment="Center" />
                        <!-- 复制结果 is an addition of this port (the original had no copy button) -->
                        <Button Grid.Column="1" Content="复制结果" Click="OnCopyClick" MinWidth="96" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="可用地址:" Style="{StaticResource RowLabelStyle}" />
                        <TextBox x:Name="UsableBox" Width="180" IsReadOnly="True" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="掩码:" Style="{StaticResource RowLabelStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBox x:Name="Mask1Box" Style="{StaticResource OctetOutStyle}" />
                            <TextBlock Style="{StaticResource DotStyle}" />
                            <TextBox x:Name="Mask2Box" Style="{StaticResource OctetOutStyle}" />
                            <TextBlock Style="{StaticResource DotStyle}" />
                            <TextBox x:Name="Mask3Box" Style="{StaticResource OctetOutStyle}" />
                            <TextBlock Style="{StaticResource DotStyle}" />
                            <TextBox x:Name="Mask4Box" Style="{StaticResource OctetOutStyle}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="网络:" Style="{StaticResource RowLabelStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBox x:Name="Net1Box" Style="{StaticResource OctetOutStyle}" />
                            <TextBlock Style="{StaticResource DotStyle}" />
                            <TextBox x:Name="Net2Box" Style="{StaticResource OctetOutStyle}" />
                            <TextBlock Style="{StaticResource DotStyle}" />
                            <TextBox x:Name="Net3Box" Style="{StaticResource OctetOutStyle}" />
                            <TextBlock Style="{StaticResource DotStyle}" />
                            <TextBox x:Name="Net4Box" Style="{StaticResource OctetOutStyle}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="首个可用:" Style="{StaticResource RowLabelStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBox x:Name="First1Box" Style="{StaticResource OctetOutStyle}" />
                            <TextBlock Style="{StaticResource DotStyle}" />
                            <TextBox x:Name="First2Box" Style="{StaticResource OctetOutStyle}" />
                            <TextBlock Style="{StaticResource DotStyle}" />
                            <TextBox x:Name="First3Box" Style="{StaticResource OctetOutStyle}" />
                            <TextBlock Style="{StaticResource DotStyle}" />
                            <TextBox x:Name="First4Box" Style="{StaticResource OctetOutStyle}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- The original label really does use a full-width colon here
                         while every other row uses ASCII ':' (docs/re/03 §B.1). -->
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="末个可用：" Style="{StaticResource RowLabelStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBox x:Name="Last1Box" Style="{StaticResource OctetOutStyle}" />
                            <TextBlock Style="{StaticResource DotStyle}" />
                            <TextBox x:Name="Last2Box" Style="{StaticResource OctetOutStyle}" />
                            <TextBlock Style="{StaticResource DotStyle}" />
                            <TextBox x:Name="Last3Box" Style="{StaticResource OctetOutStyle}" />
                            <TextBlock Style="{StaticResource DotStyle}" />
                            <TextBox x:Name="Last4Box" Style="{StaticResource OctetOutStyle}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="广播:" Style="{StaticResource RowLabelStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBox x:Name="Bcast1Box" Style="{StaticResource OctetOutStyle}" />
                            <TextBlock Style="{StaticResource DotStyle}" />
                            <TextBox x:Name="Bcast2Box" Style="{StaticResource OctetOutStyle}" />
                            <TextBlock Style="{StaticResource DotStyle}" />
                            <TextBox x:Name="Bcast3Box" Style="{StaticResource OctetOutStyle}" />
                            <TextBlock Style="{StaticResource DotStyle}" />
                            <TextBox x:Name="Bcast4Box" Style="{StaticResource OctetOutStyle}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ================= extras ================= -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="6">
                    <TextBlock Text="附加信息（本次移植新增，不影响上面的输出）" Style="{StaticResource SectionHeaderStyle}" />
                    <TextBlock x:Name="CidrText" Style="{StaticResource HintTextStyle}" />
                    <TextBlock x:Name="WildcardText" Style="{StaticResource HintTextStyle}" />
                    <TextBlock Style="{StaticResource HintTextStyle}"
                               Text="原版的掩码位输入上限是 30，/31 与 /32 的分支在旧界面里不可达；本移植开放 0 - 32，/31 显示 two hosts、/32 显示 one host（与计算引擎的返回一致）。" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
