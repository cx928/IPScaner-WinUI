<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="IPScaner.WinUI.Views.ScanPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:vm="using:IPScaner.WinUI.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Required">

    <Grid Padding="16,12,16,12" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ================= toolbar ================= -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}">
            <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="IP段" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox x:Name="SegmentBox" Width="140" PlaceholderText="192.168.1"
                             ToolTipService.ToolTip="输入前三段，例如 192.168.1" />
                    <ComboBox x:Name="AdapterCombo" Width="210" PlaceholderText="选择网卡 / 网段"
                              ToolTipService.ToolTip="从本机网卡快速填入网段"
                              SelectionChanged="OnAdapterSelected" />
                    <Button x:Name="StartButton" Content="开始" Click="OnStartClick"
                            Style="{StaticResource AccentButtonStyle}" MinWidth="76" />
                    <Button x:Name="StopButton" Content="停止" Click="OnStopClick" MinWidth="76" IsEnabled="False" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ToggleButton x:Name="HostNameToggle" Content="主机名查询"
                                  ToolTipService.ToolTip="开启后显示计算机名称与MAC，会明显降低扫描速度"
                                  Click="OnHostNameToggled" />
                    <ToggleButton x:Name="ListViewToggle" Content="列表视图"
                                  ToolTipService.ToolTip="在色块视图与列表视图之间切换"
                                  Click="OnListViewToggled" />
                    <Button Content="清空缓存" Click="OnClearCachesClick"
                            ToolTipService.ToolTip="清除已缓存的主机名与MAC地址" />
                    <Button Content="导出结果" Click="OnExportClick"
                            ToolTipService.ToolTip="导出为 CSV / Excel" />
                    <Button Content="复制全部正常" Click="OnCopyOnlineClick" />
                    <Button Content="备注管理" Click="OnOpenMemoClick" />
                    <TextBlock x:Name="ProgressText" Style="{StaticResource HintTextStyle}"
                               VerticalAlignment="Center" Margin="8,0,0,0"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ================= legend ================= -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="18">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Border x:Name="LegendOnline" Style="{StaticResource LegendSwatchStyle}" />
                <HyperlinkButton x:Name="OnlineLink" Click="OnCopyOnlineClick" Padding="2,0,2,0"
                                 ToolTipService.ToolTip="点击复制所有通讯【正常】的IP地址" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Border x:Name="LegendOffline" Style="{StaticResource LegendSwatchStyle}" />
                <HyperlinkButton x:Name="OfflineLink" Click="OnCopyOfflineClick" Padding="2,0,2,0"
                                 ToolTipService.ToolTip="点击复制所有通讯【异常】的IP地址" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Border x:Name="LegendPending" Style="{StaticResource LegendSwatchStyle}" />
                <TextBlock x:Name="PendingText" Style="{StaticResource StatusTextStyle}" Text="待检测 254" />
            </StackPanel>
            <TextBlock x:Name="SummaryText" Style="{StaticResource StatusTextStyle}" Text="尚未扫描" />
        </StackPanel>

        <!-- ================= blocks ================= -->
        <ScrollViewer x:Name="BlockScroll" Grid.Row="2" Padding="4"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsRepeater x:Name="BlockRepeater" ItemsSource="{x:Bind Blocks}">
                <ItemsRepeater.Layout>
                    <UniformGridLayout MinItemWidth="58" MinItemHeight="38"
                                       MinRowSpacing="2" MinColumnSpacing="2"
                                       ItemsStretch="None" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:IpBlock">
                        <Button Style="{StaticResource IpBlockButtonStyle}"
                                Background="{x:Bind Background, Mode=OneWay}"
                                Foreground="{x:Bind Foreground, Mode=OneWay}"
                                Content="{x:Bind Label}"
                                ToolTipService.ToolTip="{x:Bind Tooltip, Mode=OneWay}"
                                Tapped="OnBlockTapped"
                                DoubleTapped="OnBlockDoubleTapped"
                                RightTapped="OnBlockRightTapped" />
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>

        <!-- ================= list view ================= -->
        <ListView x:Name="ResultList" Grid.Row="2" Visibility="Collapsed"
                  SelectionMode="Single" IsItemClickEnabled="True"
                  ItemClick="OnListItemClick">
            <ListView.HeaderTemplate>
                <DataTemplate>
                    <Grid Padding="12,6" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="IP" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="状态" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="主机名" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="3" Text="MAC" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="4" Text="备注" FontWeight="SemiBold" />
                    </Grid>
                </DataTemplate>
            </ListView.HeaderTemplate>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:IpBlock">
                    <Grid Padding="12,4" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{x:Bind Ip}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind StatusText, Mode=OneWay}" />
                        <TextBlock Grid.Column="2" Text="{x:Bind HostName, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="3" Text="{x:Bind Mac, Mode=OneWay}" />
                        <TextBlock Grid.Column="4" Text="{x:Bind Memo, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
