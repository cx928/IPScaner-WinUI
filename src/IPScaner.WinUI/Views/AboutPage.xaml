<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="IPScaner.WinUI.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Required">

    <ScrollViewer Padding="28,24,28,24" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="14" MaxWidth="860" HorizontalAlignment="Left">

            <StackPanel Orientation="Horizontal" Spacing="12">
                <FontIcon Glyph="&#xE968;" FontSize="34" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="局域网IP扫描工具" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock x:Name="VersionLine" Style="{StaticResource HintTextStyle}" />
                </StackPanel>
            </StackPanel>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="6">
                    <TextBlock Text="关于本次重构" Style="{StaticResource SectionHeaderStyle}" />
                    <TextBlock Style="{StaticResource HintTextStyle}" TextWrapping="Wrap"
                               Text="本程序是 IPScaner V1.28.2（WinForms / .NET Framework）的 WinUI 3 重构版。原有的全部 11 项功能均已移植：IP段扫描、修改本地IP、IP批量扫描、IP地址计算器、目标端口扫描、本机端口占用查看、WiFi密码查看、Windows命令、备注管理、桌面显示本机IP、关于。" />
                    <TextBlock Style="{StaticResource HintTextStyle}" TextWrapping="Wrap"
                               Text="界面层使用 Windows App SDK / WinUI 3，扫描引擎拆分为独立的 IPScaner.Core 类库，可单独测试。配置文件 IPScaner.cfg、备注文件 IPScanerMemo.dat、自定义命令 command.txt 与历史 IP 文件 ipScaner_his.xml 的格式与旧版完全兼容，可直接沿用原有文件。" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="6">
                    <TextBlock Text="运行环境" Style="{StaticResource SectionHeaderStyle}" />
                    <TextBlock x:Name="EnvironmentLine" Style="{StaticResource HintTextStyle}" />
                    <TextBlock x:Name="PathLine" Style="{StaticResource HintTextStyle}" />
                    <TextBlock x:Name="ElevationLine" Style="{StaticResource HintTextStyle}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="6">
                    <TextBlock Text="与旧版的差异" Style="{StaticResource SectionHeaderStyle}" />
                    <TextBlock Style="{StaticResource HintTextStyle}" TextWrapping="Wrap" Text="• 不再强制每次启动请求管理员权限；仅在【修改本地IP】和清空ARP缓存时需要，界面上提供按需提权入口。" />
                    <TextBlock Style="{StaticResource HintTextStyle}" TextWrapping="Wrap" Text="• 扫描并发受控（默认 64 并发），停止扫描会立即取消并丢弃在途结果，不再出现旧版停止后色块仍被改写的问题。" />
                    <TextBlock Style="{StaticResource HintTextStyle}" TextWrapping="Wrap" Text="• ARP 表一次读取、复用 3 秒，替代旧版每台主机启动一次 arp -a 子进程的做法；MAC 匹配由子串改为精确匹配。" />
                    <TextBlock Style="{StaticResource HintTextStyle}" TextWrapping="Wrap" Text="• 端口列表支持范围写法（如 80,443,1000-2000）；本机端口占用改用 GetExtendedTcpTable/UDP API，可显示 TCP 状态与 IPv6，不再依赖 netstat 文本解析。" />
                    <TextBlock Style="{StaticResource HintTextStyle}" TextWrapping="Wrap" Text="• WiFi 密码解析不再依赖中文标记，英文版 Windows 同样可用。" />
                    <TextBlock Style="{StaticResource HintTextStyle}" TextWrapping="Wrap" Text="• 导出不再只写 CSV：新增真正的 .xlsx；CSV 默认带 UTF-8 BOM，避免 Excel 中文乱码。" />
                    <TextBlock Style="{StaticResource HintTextStyle}" TextWrapping="Wrap" Text="• 掩码位输入支持 0–32（旧版界面上限为 30，/31 与 /32 不可达）。" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="6">
                    <TextBlock Text="更新说明" Style="{StaticResource SectionHeaderStyle}" />
                    <TextBlock x:Name="ChangelogText" Style="{StaticResource HintTextStyle}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="联系方式" Style="{StaticResource SectionHeaderStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="官方网站：" Style="{StaticResource FieldLabelStyle}" />
                        <HyperlinkButton x:Name="SiteLink" Click="OnOpenSite" Padding="2,0,2,0" />
                        <Button Content="复制网址" FontSize="12" Click="OnCopySite" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="电子邮箱：" Style="{StaticResource FieldLabelStyle}" />
                        <HyperlinkButton x:Name="MailLink" Click="OnOpenMail" Padding="2,0,2,0" />
                        <Button Content="复制邮箱" FontSize="12" Click="OnCopyMail" />
                    </StackPanel>
                    <TextBlock x:Name="RepoLine" Style="{StaticResource HintTextStyle}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="6">
                    <TextBlock Text="开源许可" Style="{StaticResource SectionHeaderStyle}" />
                    <TextBlock Style="{StaticResource HintTextStyle}" TextWrapping="Wrap"
                               Text="本程序使用以下开源组件：.NET 8 与 Windows App SDK / WinUI 3（MIT）、PDFsharp（MIT）、WiX Toolset v5（MS-RL）、System.Management（MIT）。" />
                    <TextBlock Style="{StaticResource HintTextStyle}" TextWrapping="Wrap"
                               Text="隐私说明：本程序完全在本机运行，不含任何统计或上报代码，不会向开发者或第三方发送任何信息。详细信息见安装程序中的《隐私政策与用户须知》。" />
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource HintTextStyle}"
                       Text="原始版本 Copyright © chenhuxiang@qq.com 2019-2025" />
        </StackPanel>
    </ScrollViewer>
</Page>
