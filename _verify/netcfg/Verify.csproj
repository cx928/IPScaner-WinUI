<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <OutputType>Exe</OutputType>
    <AssemblyName>VerifyNetCfg</AssemblyName>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="IPScaner.Core">
      <HintPath>..\..\src\IPScaner.Core\bin\Debug\net8.0-windows\IPScaner.Core.dll</HintPath>
    </Reference>
    <Compile Include="..\..\src\IPScaner.Core\Net\WifiService.cs" />
    <Compile Include="..\..\src\IPScaner.Core\Net\NetworkConfigurator.cs" />
    <Compile Include="..\..\src\IPScaner.Core\Net\NetworkHistory.cs" />
  </ItemGroup>
</Project>
