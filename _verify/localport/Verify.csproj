<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <OutputType>Exe</OutputType>
    <AssemblyName>VerifyLocalPort</AssemblyName>
    <RootNamespace>VerifyLocalPort</RootNamespace>
    <!-- CA1416: windows-only APIs on a windows TFM. CS0436: once the real IPScaner.Core build has
         picked up LocalPortTable.cs, the same type also exists in the referenced DLL; the compiler
         prefers the local source copy (which is the file under test), so this warning is expected. -->
    <NoWarn>$(NoWarn);CA1416;CS0436</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="IPScaner.Core">
      <HintPath>..\..\src\IPScaner.Core\bin\Debug\net8.0-windows\IPScaner.Core.dll</HintPath>
    </Reference>
    <Compile Include="..\..\src\IPScaner.Core\Net\LocalPortTable.cs" />
  </ItemGroup>

</Project>
