.vs/

# Packaging output — the installers are attached to GitHub Releases instead of
# being committed, so the repository stays small.
artifacts/
_work/

# Verification harness build output (the harness sources themselves are tracked)
_verify/**/bin/
_verify/**/obj/

# Runtime data files written next to the executable by the portable build.
# A developer's own config/memo/history must never be committed.
IPScaner.cfg
IPScanerMemo.dat
IPScaner.dat
ipScaner_his.xml
command.txt
Logs/
导出/
*.broken
*.tmp

# Tooling
*.log
!docs/**/*.log
