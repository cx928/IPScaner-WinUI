<?xml version="1.0" encoding="UTF-8"?>
<!--
  MSI definition for IPScaner WinUI.

  @VERSION@, @PAYLOAD@ and @ICON@ are substituted by build\package.ps1.

  The file list is harvested with WiX's <Files Include="..."> element rather than
  by generating one <Component> per file, so adding or removing a file from the
  publish output needs no change here.

  Scope is perMachine, so the install directory is under Program Files. The app
  therefore cannot keep its settings beside the executable; IPScaner.Core's
  AppPaths detects that and redirects the config, memo, history, command and log
  files to %APPDATA%\IPScaner.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package
      Name="局域网IP扫描工具 (IPScaner)"
      Manufacturer="IPScaner  ·  www.xiaorin.cn"
      Version="@VERSION@.0"
      UpgradeCode="{7E4B1C9A-2D63-4F58-9A17-8C5E3B0D6F42}"
      Scope="perMachine"
      Language="2052"
      Codepage="65001"
      InstallerVersion="500">

    <!--
      Shown on the licence page of the installer (WixUI_InstallDir). Generated from
      privacy-zh.txt by make-privacy-rtf.ps1 — the \uN? escapes matter, see that script.
      WixVariable has to live inside Package in WiX v5.
    -->
    <WixVariable Id="WixUILicenseRtf" Value="@LICENSE_RTF@" />

    <SummaryInformation
        Description="局域网IP扫描工具 WinUI 版 —— IP段扫描、端口扫描、修改本地IP、WiFi密码查看等"
        Manufacturer="IPScaner  ·  www.xiaorin.cn" />

    <MajorUpgrade
        DowngradeErrorMessage="已安装更新版本的局域网IP扫描工具，请先卸载后再安装。" />

    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!--
      Welcome -> 隐私政策(licence) -> 选择安装位置(InstallDir) -> 确认 -> 安装。
      WixUI_InstallDir is what provides both the agreement page and the folder
      picker; InstallDirectory binds the picker to INSTALLFOLDER.
    -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />

    <Icon Id="AppIcon" SourceFile="@ICON@" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPCOMMENTS" Value="局域网IP扫描工具（WinUI 3 重构版）" />
    <Property Id="ARPHELPLINK" Value="https://www.xiaorin.cn" />
    <Property Id="ARPURLINFOABOUT" Value="https://www.xiaorin.cn" />
    <Property Id="ARPCONTACT" Value="wanghaotian@cxdx.deu.kg" />

    <!--
      The app needs no elevation to run: it only requests it for 修改本地IP and
      for flushing the ARP cache, both of which surface an on-demand restart.
    -->
    <Property Id="MSIINSTALLPERUSER" Value="0" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="IPScaner" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppMenuFolder" Name="局域网IP扫描工具" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="Main" Title="局域网IP扫描工具" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentGroupRef Id="AppShortcuts" />
    </Feature>

  </Package>

  <!-- ===================== application payload ===================== -->
  <Fragment>
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="@PAYLOAD@\**" />
    </ComponentGroup>
  </Fragment>

  <!-- ===================== shortcuts ===================== -->
  <!--
    Shortcut components are keyed on a per-user registry value. That is what lets
    an uninstall clean up the Start Menu entry and the desktop icon without
    needing to know which user created them.
  -->
  <Fragment>
    <ComponentGroup Id="AppShortcuts">

      <Component Id="StartMenuShortcut" Directory="AppMenuFolder" Guid="{3A9D6E12-7C48-4B03-8F5A-1E2B7D9C4A60}">
        <Shortcut Id="StartMenuLink"
                  Name="局域网IP扫描工具"
                  Description="局域网IP扫描工具（WinUI 3 版）"
                  Target="[INSTALLFOLDER]IPScaner.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon" />
        <RemoveFolder Id="RemoveAppMenuFolder" Directory="AppMenuFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\IPScaner" Name="StartMenuShortcut"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <Component Id="DesktopShortcut" Directory="DesktopFolder" Guid="{C58F2A47-9B31-4E76-A0D4-6F13E8B52C97}">
        <Shortcut Id="DesktopLink"
                  Name="局域网IP扫描工具"
                  Description="局域网IP扫描工具（WinUI 3 版）"
                  Target="[INSTALLFOLDER]IPScaner.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon" />
        <RegistryValue Root="HKCU" Key="Software\IPScaner" Name="DesktopShortcut"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>

    </ComponentGroup>
  </Fragment>

</Wix>
